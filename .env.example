# ─── Public (sent to the browser) ───
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Older Supabase projects use this name instead — code accepts either:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Base URL of the deployed app — used to build Square OAuth redirect.
# Locally: http://localhost:3000
# Production: https://lickingooddonuts.net
NEXT_PUBLIC_APP_URL=https://lickingooddonuts.net

# Square Developer App — single app, multiple merchants.
# https://developer.squareup.com/apps
NEXT_PUBLIC_SQUARE_APP_ID=

# ─── Server-only secrets (NEVER expose) ───
SUPABASE_SERVICE_ROLE_KEY=
SQUARE_APP_SECRET=

# "sandbox" or "production"
SQUARE_ENVIRONMENT=sandbox

# Comma-separated emails allowed into /admin/*.
ADMIN_EMAILS=
